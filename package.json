{
  "type": "module",
  "name": "@obvia/cvx",
  "description": "High-performance class variants, class composition, and Tailwind-aware conflict resolution for modern TypeScript applications.",
  "keywords": [
    "obvia",
    "class",
    "className",
    "variants",
    "css",
    "tailwindcss",
    "cva",
    "clsx",
    "tailwind-merge",
    "classnames",
    "cn",
    "cx",
    "cv"
  ],
  "license": "MIT",
  "homepage": "https://obvia.studio/",
  "version": "0.1.0",
  "author": {
    "name": "Selçuk Çukur",
    "email": "hello@selcukcukur.me",
    "url": "https://selcukcukur.me"
  },
  "bugs": {
    "email": "security@obvia.dev",
    "url": "https://github.com/obvialabs/cvx/issues"
  },
  "scripts": {
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "bench": "bun bench/compare.bench.ts",
    "pack": "bun run build && bun pm pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obvialabs/cvx.git"
  },
  "packageManager": "bun@1.4.2",
  "files": [
    "dist",
    "license.md",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "readme.md"
  ],
  "devDependencies": {
    "@types/bun": "1.4.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cva": "1.0.0-beta.12",
    "tailwind-merge": "3.6.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
