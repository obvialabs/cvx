{
  "compilerOptions" : {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "isolatedDeclarations": false,
    "declaration": true,
    "noEmit": true
  },
  "include"         : ["src/**/*.ts"]
}
